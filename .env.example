# =====================================================================
# Arbitrage OS — environment. Copy to .env (never commit .env).
# Defaults run everything OFFLINE with mocks + a local JSON store.
# =====================================================================

# ---------- SAFETY (Phase 2 only — keep false) ----------
AUTO_BUY_ENABLED=false
AUTO_BUY_MIN_SCORE=90
AUTO_BUY_MIN_CONFIDENCE=80

# ---------- Storage ----------
# file = local JSON under DATA_DIR (dev/tests) | supabase = production
STORE_PROVIDER=file
DATA_DIR=.data
SUPABASE_URL=
# Service-role key: server-side only (Vercel env / local .env). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM (adapter: mock | anthropic | openai) ----------
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model per tier. Default is Claude Opus 5.5 ($4 / $20 per MTok). See docs/DECISIONS.md (#1) for the cost trade-off.
ANTHROPIC_MODEL_FAST=claude-opus-5-5
ANTHROPIC_MODEL_UNDERWRITER=claude-opus-5-5
ANTHROPIC_EFFORT_FAST=low
ANTHROPIC_EFFORT_UNDERWRITER=medium
# OpenAI alternative (models and prices must be set explicitly; nothing is defaulted)
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_UNDERWRITER=
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
# Hard stop for LLM spend inside a single run (USD)
RUN_LLM_BUDGET_USD=3

# ---------- Registrar (adapter: mock | cloudflare_sandbox | cloudflare) ----------
# cloudflare_sandbox -> /registrar-sandbox/domain-check (development)
# cloudflare         -> /registrar/domain-check (read-only, real-time registry check; no purchase is ever made)
REGISTRAR_PROVIDER=mock
CLOUDFLARE_ACCOUNT_ID=
# Token scope for the MVP: Registrar read is enough for domain-check. Do NOT grant write until Phase 2.
CLOUDFLARE_API_TOKEN=

# ---------- Market data (adapter: mock | namebio | none) ----------
MARKET_PROVIDER=mock
NAMEBIO_EMAIL=
NAMEBIO_API_KEY=
# Unknown until you buy credits; leave empty and costs are recorded as "unknown" (never guessed)
NAMEBIO_USD_PER_CREDIT=
# Comps cost 25 credits per call
NAMEBIO_MAX_COMPS_CALLS_PER_RUN=20
NAMEBIO_COMPS_MONTHS_OLD=60

# ---------- Trend sources (comma list: mock, hackernews, github, rss, reddit, producthunt) ----------
TREND_SOURCES=mock
TREND_LOOKBACK_DAYS=7
TREND_RECENT_DAYS=2
HN_MIN_POINTS=30
GITHUB_TOKEN=
GITHUB_MIN_STARS=50
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=arbitrage-os/0.1 (by u/your_username)
REDDIT_SUBREDDITS=SaaS,startups,artificial,LocalLLaMA,Entrepreneur
PRODUCTHUNT_TOKEN=
RSS_FEEDS=https://techcrunch.com/category/startups/feed/,https://techcrunch.com/category/artificial-intelligence/feed/

# ---------- Funnel sizing ----------
TLDS=com,ai
MAX_CONCEPTS=8
MAX_CANDIDATES_PER_CONCEPT=300
MAX_AVAILABILITY_CHECKS=400
AVAILABILITY_CACHE_DAYS=14
MAX_ENRICH=25
MAX_UNDERWRITE=12
# Hard-capped at 5 in code
MAX_DIGEST=5
MAX_PER_CONCEPT_IN_DIGEST=2

# ---------- Underwriting rules ----------
MIN_SCORE=75
MIN_CONFIDENCE=60
REQUIRE_POSITIVE_EV=true
CONFIDENCE_CAP_NO_MARKET_DATA=55
# Max registration price for a name to be ANALYZED (the purchase cap is MAX_ASSET_COST below)
ANALYSIS_MAX_ASSET_COST=100

# ---------- Expected value assumptions (ESTIMATES) ----------
SELL_THROUGH_ANNUAL_BASE=0.01
MARKETPLACE_FEE_PCT=0.20

# ---------- Budget guard (Phase 2; no purchases in MVP) ----------
MONTHLY_BUDGET=200
MAX_ASSET_COST=15
MAX_DAILY_ASSETS=2
MAX_MONTHLY_ASSETS=20

# ---------- Dashboard / API ----------
# Bearer token n8n uses to call POST /api/runs (generate: openssl rand -hex 32)
API_SECRET=
DASHBOARD_USER=diego
DASHBOARD_PASSWORD=
DASHBOARD_URL=http://localhost:3000
DECISION_ACTOR=diego
# Optional: `npm run scout -- --slack` posts the digest here
SLACK_WEBHOOK_URL=

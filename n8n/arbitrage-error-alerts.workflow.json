{
  "name": "Arbitrage OS — Error alerts",
  "nodes": [
    {
      "id": "e1f0a001-0000-4000-8000-000000000001",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "e1f0a001-0000-4000-8000-000000000002",
      "name": "Alert to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [240, 0],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#arbitrage-os" },
        "text": "=:rotating_light: n8n workflow *{{ $json.workflow.name }}* failed at node *{{ $json.execution.lastNodeExecuted }}*: {{ $json.execution.error.message }}\n{{ $json.execution.url }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Slack bot" }
      }
    }
  ],
  "connections": {
    "On workflow error": { "main": [[{ "node": "Alert to Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}

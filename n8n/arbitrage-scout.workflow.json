{
  "name": "Arbitrage OS — RUN SCOUT (2x/day)",
  "nodes": [
    {
      "id": "b1f0a001-0000-4000-8000-000000000001",
      "name": "Schedule 08:45 & 17:45 ART",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "45 8,17 * * *" }
          ]
        }
      }
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000002",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 100],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "c0nf1g01-0000-4000-8000-000000000001", "name": "api_base_url", "value": "https://YOUR-PROJECT.vercel.app", "type": "string" },
            { "id": "c0nf1g01-0000-4000-8000-000000000002", "name": "trigger", "value": "n8n-schedule", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000004",
      "name": "RUN SCOUT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100],
      "notes": "POST /api/runs with Header Auth credential 'Arbitrage OS API' (Authorization: Bearer <API_SECRET>). Never retried automatically: a run costs money.",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base_url }}/api/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ trigger: $json.trigger }) }}",
        "options": {
          "timeout": 300000,
          "response": { "response": { "neverError": true } }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Arbitrage OS API" }
      }
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000005",
      "name": "Run succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c0nd0001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000006",
      "name": "Post digest to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [960, 0],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#arbitrage-os" },
        "text": "={{ $json.digest_text }}",
        "otherOptions": { "unfurl_links": false, "includeLinkToWorkflow": false }
      },
      "credentials": {
        "slackApi": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Slack bot" }
      }
    },
    {
      "id": "b1f0a001-0000-4000-8000-000000000007",
      "name": "Alert: run failed",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [960, 200],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#arbitrage-os" },
        "text": "=:rotating_light: Arbitrage OS run failed: {{ $json.error ?? ($json.errors || []).join(' | ') ?? 'unknown error' }}",
        "otherOptions": { "includeLinkToWorkflow": true }
      },
      "credentials": {
        "slackApi": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Slack bot" }
      }
    }
  ],
  "connections": {
    "Schedule 08:45 & 17:45 ART": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Manual run": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "RUN SCOUT", "type": "main", "index": 0 }]] },
    "RUN SCOUT": { "main": [[{ "node": "Run succeeded?", "type": "main", "index": 0 }]] },
    "Run succeeded?": {
      "main": [
        [{ "node": "Post digest to Slack", "type": "main", "index": 0 }],
        [{ "node": "Alert: run failed", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Argentina/Buenos_Aires",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 600
  },
  "pinData": {}
}
